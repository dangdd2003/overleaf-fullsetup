extends ../layout-website-redesign

block vars
	- isWebsiteRedesign = true

block content
	main#main-content
		.auth-aux-container(style='max-width: 400px')
			h1.h3.mb-3 #{translate("oauth_authorization_request")}

			p.mb-3
				strong #{client.name || client.id}
				|  #{translate("oauth_wants_access")}

			if user && user.email
				p.small.text-muted.mb-4
					| #{translate("oauth_signed_in_as")}
					|
					strong #{user.email}

			.form-group.mb-4
				p.small.text-muted.mb-1 #{translate("oauth_permissions_requested")}
				ul.ps-4.mb-0
					li
						strong #{scope}
						|  — #{translate("oauth_scope_mcp_desc")}

			form(action='/oauth/authorize' method='POST')
				input(name='_csrf' type='hidden' value=csrfToken)
				input(name='client_id' type='hidden' value=client.id)
				input(name='redirect_uri' type='hidden' value=redirect_uri)
				input(name='response_type' type='hidden' value=response_type)
				input(name='code_challenge' type='hidden' value=code_challenge)
				input(name='code_challenge_method' type='hidden' value=code_challenge_method)
				if state
					input(name='state' type='hidden' value=state)
				if scope
					input(name='scope' type='hidden' value=scope)

				button.btn.btn-primary.w-100.mb-3(type='submit' name='action' value='authorize')
					| #{translate("oauth_authorize_button")}
				button.btn.btn-secondary.w-100(type='submit' name='action' value='deny')
					| #{translate("oauth_cancel_button")}
