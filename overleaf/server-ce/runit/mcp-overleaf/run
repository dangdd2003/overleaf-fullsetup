#!/bin/bash

NODE_PARAMS=""
if [ "$DEBUG_NODE" == "true" ]; then
    echo "running debug - mcp"
    NODE_PARAMS="--inspect=0.0.0.0:30700"
fi

source /etc/overleaf/env.sh

# The MCP service is off by default. runsv restarts anything that exits, so
# idle instead of exiting: an exit here would spin the supervisor.
if [ "$(echo "${MCP_ENABLED:-false}" | tr '[:upper:]' '[:lower:]')" != "true" ]; then
    echo "MCP service disabled (MCP_ENABLED is not true), idling"
    exec sleep infinity
fi

# The service binds loopback on a fixed port and web is reached on a fixed
# internal URL (services/mcp/src/config.js); nginx terminates external traffic.
# Must match web's siteUrl default (config/settings.js): it is the JWT issuer.
export OVERLEAF_SITE_URL="${OVERLEAF_SITE_URL:-http://localhost}"

exec /sbin/setuser www-data /usr/bin/node $NODE_PARAMS /overleaf/services/mcp/app.js >> /var/log/overleaf/mcp.log 2>&1
