# ==============================================================================
# Overleaf CE Extend - Environment Configuration Template
# ==============================================================================
# Copy this file to variable.env and customize for your deployment:
#   cp variable.env.example variable.env
#
# By default, all extension features are disabled (false). Out of the box,
# Overleaf CE Extend functions as a pure, clean upstream Overleaf Community
# Edition instance using the all-in-one image.
#
# Only mandatory environment variables (marked with * in README.md) are
# included below.
# ==============================================================================

# ==============================================================================
# Core Overleaf Community Edition Configuration
# ==============================================================================

# MongoDB database connection URL
OVERLEAF_MONGO_URL=mongodb://mongo/overleaf

# Redis server connection details
OVERLEAF_REDIS_HOST=redis
OVERLEAF_REDIS_PORT=6379

# Base URL where the Overleaf instance is accessible
OVERLEAF_SITE_URL=http://localhost

# Application display name
OVERLEAF_APP_NAME="Overleaf Community Edition"

# Primary administrator contact email
OVERLEAF_ADMIN_EMAIL=admin@example.com

# Enables thumbnail and document conversion using ImageMagick
ENABLE_CONVERSIONS=true

# Disables email confirmation requirement for new user registrations
EMAIL_CONFIRMATION_DISABLED=true


# ==============================================================================
# 1. AI Assist
# ==============================================================================
# Master toggle to enable or disable the AI Assist module and UI panel (*).
AI_ASSIST_ENABLED=false

# Enables web search and fetch tools for the AI assistant (*).
AI_ASSIST_WEB_TOOLS_ENABLED=false

# Browser service integration for dynamic JavaScript page rendering (optional).
# AI_ASSIST_BROWSER_TOKEN should have minimum 32 characters.
AI_ASSIST_BROWSER_URL=
AI_ASSIST_BROWSER_TOKEN=

# Server-wide web search pool (optional, all disabled by default).
# When AI_ASSIST_WEB_SEARCH_SERVER_ENABLED=true, each provider with keys/URLs
# joins the rotation pool. Per-provider keys are comma-separated for rotation.
# AI_ASSIST_WEB_SEARCH_SERVER_ENABLED=false
# AI_ASSIST_WEB_SEARCH_ROTATION_STRATEGY=round-robin
# AI_ASSIST_WEB_SEARCH_PRIMARY_PROVIDER=searxng
# TinyFish Search: GET https://api.search.tinyfish.ai with X-API-Key.
# Keys from https://agent.tinyfish.ai/api-keys (prefix sk-tinyfish-).
# Free up to daily allowance, 30 req/min per key. Disabled when empty.
# AI_ASSIST_TINYFISH_API_KEYS=
# AI_ASSIST_TINYFISH_BASE_URL=https://api.search.tinyfish.ai
# Parallel Search & Extract: POST https://api.parallel.ai with x-api-key.
# Keys from https://platform.parallel.ai. Disabled when empty.
# AI_ASSIST_PARALLEL_API_KEYS=
# AI_ASSIST_PARALLEL_BASE_URL=https://api.parallel.ai


# ==============================================================================
# 2. Collaboration & Review
# ==============================================================================
# Master toggle for all collaboration features: comments, track changes, the
# Reviewer role, @mentions, in-app notifications, and email digests (*).
COLLABORATION_ENABLED=false


# ==============================================================================
# 3. Google Drive Sync
# ==============================================================================
# Enables bi-directional synchronization between Overleaf projects and Google Drive (*).
GOOGLE_DRIVE_ENABLED=false

# Google OAuth 2.0 credentials obtained from Google Cloud Console (required if enabled) (*).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=


# ==============================================================================
# 4. GitHub Sync
# ==============================================================================
# Enables or disables GitHub synchronization functionality across the instance (*).
GITHUB_SYNC_ENABLED=false

# GitHub OAuth 2.0 App credentials and encryption secret (required if enabled) (*).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_SECRET=


# ==============================================================================
# 5. Git Bridge & Personal Access Tokens (PAT)
# ==============================================================================
# Environment variables for service `sharelatex` (in variable.env):
# Master toggle to enable Git Bridge routing, Personal Access Tokens, and Nginx proxying (*).
GIT_BRIDGE_ENABLED=false

# Container hostname, port, and internal web URL for Git Bridge service (*).
GIT_BRIDGE_HOST=git-bridge
GIT_BRIDGE_PORT=8000
GIT_BRIDGE_INTERNAL_URL=http://sharelatex:3000

# Required environment variables for service `git-bridge` container (in docker-compose.yaml) (*):
# GIT_BRIDGE_API_BASE_URL="http://sharelatex:3000/api/v0"
# GIT_BRIDGE_OAUTH2_SERVER="http://sharelatex:3000"
# GIT_BRIDGE_POSTBACK_BASE_URL="http://git-bridge:8000"
# GIT_BRIDGE_ROOT_DIR="/data" # optional, defaults to /data


# ==============================================================================
# 6. Overleaf Model Context Protocol (MCP) Server
# ==============================================================================
# Enables or disables the Overleaf MCP server service (*).
MCP_ENABLED=false


# ==============================================================================
# 7. Admin User & Project Management
# ==============================================================================
# Enables the Admin User Management module (/admin/users) (*).
ADMIN_USER_MANAGEMENT_ENABLED=false

# Enables the Admin Project Management module (/admin/project) (*).
ADMIN_PROJECT_MANAGEMENT_ENABLED=false


# ==============================================================================
# 8. TeX Live Compiles & Sandbox
# ==============================================================================
# By default, Overleaf CE executes native compilation inside the all-in-one image.
# To enable sandboxed compilation in isolated sibling containers (recommended for
# production and required for the slim image), set the mandatory variables below (*):
SANDBOXED_COMPILES=false

# Default and available pre-built TeX Live full images (*):
TEX_LIVE_DOCKER_IMAGE=dangdoan2003/texlive-full:2026
ALL_TEX_LIVE_DOCKER_IMAGES=dangdoan2003/texlive-full:2026,dangdoan2003/texlive-full:2025,dangdoan2003/texlive-full:2024,dangdoan2003/texlive-full:2023,dangdoan2003/texlive-full:2022
ALL_TEX_LIVE_DOCKER_IMAGE_NAMES="2026 (Latest),2025,2024,2023,2022"


# ==============================================================================
# 9. Public API Documentation
# ==============================================================================
# Enables the interactive API documentation UI at /api-docs and OpenAPI JSON
# schema endpoint at /api/v0/openapi.json (*).
API_DOCS_ENABLED=false
