# ==============================================================================
# Overleaf CE Extend - environment template
# ==============================================================================
# cp variable.env.example variable.env
#
# Every extension is off by default: out of the box this is plain upstream
# Overleaf CE. Only required settings are listed; README.md has the optional ones.
# ==============================================================================

# ==============================================================================
# Core
# ==============================================================================
OVERLEAF_MONGO_URL=mongodb://mongo/overleaf
OVERLEAF_REDIS_HOST=redis
OVERLEAF_REDIS_PORT=6379

# Public URL of this instance
OVERLEAF_SITE_URL=http://localhost
OVERLEAF_APP_NAME="Overleaf Community Edition"
OVERLEAF_ADMIN_EMAIL=admin@example.com

# Fixed secret, so logins and AI connector sign-ins survive container recreation
# OVERLEAF_SESSION_SECRET=

ENABLE_CONVERSIONS=true
EMAIL_CONFIRMATION_DISABLED=true

# Outbound email / SMTP (optional; required for password resets & email notifications)
# OVERLEAF_EMAIL_FROM_ADDRESS=team@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=
# OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true
# OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false


# ==============================================================================
# 1. AI Assist
# ==============================================================================
AI_ASSIST_ENABLED=false

# Docker host IP for localhost model URLs (e.g. Ollama on host). Auto-detected if unset.
# DOCKER_HOST_GATEWAY=

# Web search and fetch
AI_ASSIST_WEB_TOOLS_ENABLED=false

# Browser service for JavaScript-heavy pages (optional). Token: 32+ characters.
AI_ASSIST_BROWSER_URL=
AI_ASSIST_BROWSER_TOKEN=

# Server web search (optional). Any key or URL set turns it on for all users.
# Keys and URLs: one value or a comma-separated list.
# AI_ASSIST_SEARXNG_URLS=
# AI_ASSIST_TAVILY_API_KEYS=
# AI_ASSIST_EXA_API_KEYS=
# AI_ASSIST_JINA_API_KEYS=
# AI_ASSIST_FIRECRAWL_API_KEYS=
# AI_ASSIST_FIRECRAWL_SELFHOSTED_URLS=
# AI_ASSIST_LANGSEARCH_API_KEYS=
# AI_ASSIST_OLLAMA_API_KEYS=
# AI_ASSIST_WEBSEARCHAPI_API_KEYS=
# AI_ASSIST_TINYFISH_API_KEYS=
# AI_ASSIST_PARALLEL_API_KEYS=
# Custom search URLs: take POST {"q": "..."}, return {"results": [...]}
# AI_ASSIST_MCP_URLS=
# AI_ASSIST_MCP_BEARER_TOKEN=
# AI_ASSIST_MCP_HEADERS=

# Web search cache (optional). Longer and larger saves API quota.
# AI_ASSIST_WEB_SEARCH_CACHE_HOURS=24
# AI_ASSIST_WEB_SEARCH_MAX_CACHED_SEARCHES=256
# AI_ASSIST_WEB_SEARCH_MAX_CACHED_PAGES=64


# ==============================================================================
# 2. Collaboration & Review
# ==============================================================================
# Comments, track changes, Reviewer role, @mentions, email digests
COLLABORATION_ENABLED=false


# ==============================================================================
# 3. Google Drive Sync
# ==============================================================================
GOOGLE_DRIVE_ENABLED=false

# Google OAuth client. Redirect URI: <OVERLEAF_SITE_URL>/oauth/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=


# ==============================================================================
# 4. GitHub Sync
# ==============================================================================
GITHUB_SYNC_ENABLED=false

# GitHub OAuth app. Callback URL: <OVERLEAF_SITE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ==============================================================================
# 5. Git Bridge & Personal Access Tokens
# ==============================================================================
GIT_BRIDGE_ENABLED=false

# Git Bridge service name and port, as in your compose file. If changed, set
# GIT_BRIDGE_POSTBACK_BASE_URL on the git-bridge container to match.
GIT_BRIDGE_HOST=git-bridge
GIT_BRIDGE_PORT=8000


# ==============================================================================
# 6. MCP Server
# ==============================================================================
# Served at <OVERLEAF_SITE_URL>/mcp
MCP_ENABLED=false
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=


# ==============================================================================
# 7. Admin
# ==============================================================================
# /admin/users
ADMIN_USER_MANAGEMENT_ENABLED=false
# /admin/project
ADMIN_PROJECT_MANAGEMENT_ENABLED=false


# ==============================================================================
# 8. Sandboxed Compiles
# ==============================================================================
# Compile in separate Docker containers (needs the Docker socket mounted;
# required for the slim image)
SANDBOXED_COMPILES=false

# Default image, all images users can pick, and their display names (same order)
TEX_LIVE_DOCKER_IMAGE=dangdoan2003/texlive-full:2026
ALL_TEX_LIVE_DOCKER_IMAGES=dangdoan2003/texlive-full:2026,dangdoan2003/texlive-full:2025,dangdoan2003/texlive-full:2024,dangdoan2003/texlive-full:2023,dangdoan2003/texlive-full:2022
ALL_TEX_LIVE_DOCKER_IMAGE_NAMES="2026 (Latest),2025,2024,2023,2022"
# Automatically pull missing TeX Live images on startup/compile
# TEX_LIVE_AUTO_PULL_ENABLED=false


# ==============================================================================
# 9. API Docs
# ==============================================================================
# /api-docs
API_DOCS_ENABLED=false


# ==============================================================================
# 10. Legal Page
# ==============================================================================
# /legal (linked from the footer as "Privacy & Terms")
LEGAL_PAGE_ENABLED=false
